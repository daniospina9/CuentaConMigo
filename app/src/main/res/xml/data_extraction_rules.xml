<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules para API 31+. API 23–30 usa backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="cuentaconmigo.db"/>
        <include domain="database" path="cuentaconmigo.db-shm"/>
        <include domain="database" path="cuentaconmigo.db-wal"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="cuentaconmigo.db"/>
        <include domain="database" path="cuentaconmigo.db-shm"/>
        <include domain="database" path="cuentaconmigo.db-wal"/>
    </device-transfer>
</data-extraction-rules>